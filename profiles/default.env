PROFILE_NAME=default
QLEVER_SERVER_HOST_NAME=default-server
OLLAMA_HOST=http://localhost:11434
OLLAMA_HOST_2=
OLLAMA_HOST_3=
OLLAMA_DEFAULT_MODEL=gemma4:e2b
#-cloud
# Optional: Set this to true if you are using an external Elasticsearch cluster
# EXT_ELASTICSEARCH=true

# Add any API keys needed for testing
# KAGGLE_USERNAME=...
# KAGGLE_KEY=...
# HF_API_KEY=...
OPENAI_API_KEY=test-api-key-12345
OLLAMA_API_KEY=test-api-key-12345

# Set host and domain
HOST=http://localhost:7070
MCP_DOMAIN=localhost
IP=127.0.0.1

# Ports configuration
QLEVER_UI_PORT=7012
ES_PORT=9200
ES_GLOBAL_HOST=
ES_GLOBAL_HOST2=http://localhost:9200
ES_HOST=http://localhost:9200
ES_JAVA_OPTS="-Xms1g -Xmx2g"
API_PORT=7013
MCP_PORT=7070
MINIO_API_PORT=9005
MINIO_CONSOLE_PORT=9007
VOLUME_DIR=./qlever-tests/volumes
VAULT_LOGO_URL=/logo.png
GEOID_SERVER=

# Converters & DDICDI services
CONVERTERS_PORT=8082
CDIF_SERVICE=http://converters:8000
